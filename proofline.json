  {
   "id": "XC-04",
   "title": "Documentation: architecture, spec mapping, threat model, roadmap, V&V",
   "phase": "verify",
   "owner": "mgillr",
   "depends_on": [
    "XC-01",
    "XC-02",
    "XC-03"
   ],
   "requirements": [
    "R-DOCS"
   ],
   "description": "Docs as listed; SPEC.md maps every check to quoted x402 V2 / SVM exact text; VV.md traces every task.",
   "scope": {
    "allow": [
     "docs/**"
    ]
   },
   "criteria": [
    {
     "id": "XC-04-AC01",
     "mandatory": true,
     "statement": "ARCHITECTURE.md has a diagram",
     "verifier": {
      "type": "grep",
      "file": "docs/ARCHITECTURE.md",
      "pattern": "```mermaid",
      "must": "present"
     }
    },
    {
     "id": "XC-04-AC02",
     "mandatory": true,
     "statement": "SPEC.md maps S1 to spec text",
     "verifier": {
      "type": "grep",
      "file": "docs/SPEC.md",
      "pattern": "^\\| S1 \\|",
      "must": "present"
     }
