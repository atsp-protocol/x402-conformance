{
 "schema": "proofline/1",
 "project": "x402-conformance",
 "owner_rules": [
  "Done means ALL evidence: every mandatory criterion of the task passes in CI on main, and the task is listed in vv/claims.json. A claim without passing criteria fails CI.",
  "Scope is closed: every tracked file belongs to some task's scope.allow; a file no task owns fails CI.",
  "Live mode is GET-only against third parties: no POST, no signing, no payment, ever. Devnet only for /verify and /settle, against facilitators run by me or with the operator's permission.",
  "No outbound spend: no paid audit, no paid infrastructure. Review is open and public.",
  "No credentials in the repository: no secret, token, private key or wallet material is committed; the hygiene scan runs in CI.",
  "Honest reporting: no users are claimed that do not exist; checks are mappings to spec text, not certification of x402 conformance.",
  "Licence: Apache-2.0, licensor Ryan Gillespie / Optitransfer (NOTICE).",
  "Root cause, then fix. No weakening tests, raising timeouts, skips, relaxed assertions or lowered thresholds.",
  "Never bypass guards: no --no-verify, no bypass env vars, no skip flags.",
  "The contract is signed only by the owner key pinned in guard/owner.pub, on the owner's machine. Agents propose and never sign."
 ],
 "defaults": {
  "base": "origin/main",
  "branch": "main",
  "flaky_reruns": 1,
  "max_corrective_cycles": 3,
  "regression_tolerance_pct": 20,
  "max_load_per_cpu": 1.5,
  "owners": [
   "mgillr"
  ]
 },
 "forbidden": {
  "test_skip_only": true,
  "timeout_raise": true,
  "assertion_removal": true,
  "test_file_deletion": true,
  "no_verify": true,
  "bypass_env": [
   "SKIP_HOOKS",
   "HUSKY=0",
   "PROOFLINE_SKIP",
   "CI_SKIP"
  ],
  "protected_values": []
 },
 "baseline": {
  "metrics": {}
 },
 "phases": [
  {
   "id": "intake"
  },
  {
   "id": "design"
  },
  {
   "id": "plan"
  },
  {
   "id": "implement"
  },
  {
   "id": "verify"
  },
  {
   "id": "integrate"
  },
  {
   "id": "release"
  },
  {
   "id": "monitor"
  }
 ],
 "tasks": [
  {
   "id": "XC-00",
   "title": "Repository spine: licence, notice, governance and contract",
   "phase": "design",
   "owner": "mgillr",
   "depends_on": [],
   "requirements": [
    "R-OPEN",
    "R-GOV"
   ],
   "description": "Apache-2.0 licence with a NOTICE naming the licensor, governance files, CODEOWNERS, the owner key pin and this contract.",
   "scope": {
    "allow": [
     "LICENSE",
     "NOTICE",
     "README.md",
     "CONTRIBUTING.md",
     "CODE_OF_CONDUCT.md",
     "SECURITY.md",
     "CHANGELOG.md",
     ".gitignore",
     ".github/CODEOWNERS",
     ".github/ISSUE_TEMPLATE/**",
     ".github/pull_request_template.md",
     "guard/**",
     "proofline.json",
     "proofline.json.sig",
     "pyproject.toml"
    ]
   },
   "criteria": [
    {
     "id": "XC-00-AC01",
     "mandatory": true,
     "statement": "LICENSE is the Apache License 2.0",
     "verifier": {
      "type": "grep",
      "file": "LICENSE",
      "pattern": "Apache License\\s+Version 2\\.0",
      "must": "present"
     }
    },
    {
     "id": "XC-00-AC02",
     "mandatory": true,
     "statement": "NOTICE names Ryan Gillespie / Optitransfer",
     "verifier": {
      "type": "grep",
      "file": "NOTICE",
      "pattern": "Ryan Gillespie / Optitransfer",
      "must": "present"
     }
    },
    {
     "id": "XC-00-AC03",
     "mandatory": true,
     "statement": "README carries the experimental label",
     "verifier": {
      "type": "grep",
      "file": "README.md",
      "pattern": "(?i)experimental",
      "must": "present"
     }
    },
    {
     "id": "XC-00-AC04",
     "mandatory": true,
     "statement": "SECURITY.md routes reports through GitHub private vulnerability reporting",
     "verifier": {
      "type": "grep",
      "file": "SECURITY.md",
      "pattern": "security/advisories/new",
      "must": "present"
     }
    },
    {
     "id": "XC-00-AC05",
     "mandatory": true,
     "statement": "SECURITY.md contains no email address",
     "verifier": {
      "type": "grep",
      "file": "SECURITY.md",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[a-z]{2,}",
      "must": "absent"
     }
    },
    {
     "id": "XC-00-AC06",
     "mandatory": true,
     "statement": "CODEOWNERS names @mgillr for everything",
     "verifier": {
      "type": "grep",
      "file": ".github/CODEOWNERS",
      "pattern": "^\\* @mgillr$",
      "must": "present"
     }
    },
    {
     "id": "XC-00-AC07",
     "mandatory": true,
     "statement": "CONTRIBUTING, CODE_OF_CONDUCT and CHANGELOG present",
     "verifier": {
      "type": "command",
      "cmd": "test -s CONTRIBUTING.md && test -s CODE_OF_CONDUCT.md && test -s CHANGELOG.md",
      "expect_exit": 0
     }
    },
    {
     "id": "XC-00-AC08",
     "mandatory": true,
     "statement": "Issue and PR templates present",
     "verifier": {
      "type": "command",
      "cmd": "test -s .github/ISSUE_TEMPLATE/bug.yml && test -s .github/ISSUE_TEMPLATE/check-proposal.yml && test -s .github/pull_request_template.md",
      "expect_exit": 0
     }
    },
    {
     "id": "XC-00-AC09",
     "mandatory": true,
     "statement": "Owner key pin present (guard/owner.pub, Ed25519 public key)",
     "verifier": {
      "type": "grep",
      "file": "guard/owner.pub",
      "pattern": "BEGIN PUBLIC KEY",
      "must": "present"
     }
    },
    {
     "id": "XC-00-AC10",
     "mandatory": true,
     "statement": "Every changed file is inside this task's scope",
     "verifier": {
      "type": "scope"
     }
    },
    {
     "id": "XC-00-AC11",
     "mandatory": true,
     "statement": "Committed and pushed to main",
     "verifier": {
      "type": "pushed"
     }
    }
   ],
   "stop_rules": [
    "If a criterion cannot pass, STOP and report what blocks it, what was tried and what is needed. Never weaken a criterion, skip a test or raise a timeout to make it pass."
   ]
  },
  {
   "id": "XC-01",
   "title": "Live checks S1-S4 over GET /supported (GET only)",
   "phase": "implement",
   "owner": "mgillr",
   "depends_on": [],
   "requirements": [
    "R-S1",
    "R-S2",
    "R-S3",
    "R-S4",
    "R-SAFE-GET"
   ],
   "description": "S1 to S4 as specified in docs/SPEC.md; the live path makes exactly one GET per target and never POSTs, signs or pays.",
   "scope": {
    "allow": [
     "src/x402conf/__init__.py",
     "src/x402conf/__main__.py",
     "src/x402conf/py.typed",
     "src/x402conf/spec.py",
     "src/x402conf/types.py",
     "src/x402conf/harness.py",
     "src/x402conf/cli.py",
     "tests/test_live.py"
    ]
   },
   "criteria": [
    {
     "id": "XC-01-AC01",
     "mandatory": true,
     "statement": "S1 rejects a SupportedResponse without kinds[], extensions[] and signers{}",
     "verifier": {
      "type": "command",
      "cmd": "PYTHONPATH=src python3 -m unittest -v tests.test_live.Live.test_s1_shape",
      "expect_exit": 0,
      "min_tests": 1,
      "max_skipped": 0,
      "timeout_s": 300,
      "test_file": "tests/test_live.py"
     }
    },
    {
     "id": "XC-01-AC02",
     "mandatory": true,
     "statement": "S2 rejects a V2 kind whose network is not CAIP-2",
     "verifier": {
      "type": "command",
      "cmd": "PYTHONPATH=src python3 -m unittest -v tests.test_live.Live.test_s2_non_caip2",
      "expect_exit": 0,
      "min_tests": 1,
      "max_skipped": 0,
      "timeout_s": 300,
      "test_file": "tests/test_live.py"
     }
    },
    {
     "id": "XC-01-AC03",
     "mandatory": true,
     "statement": "S3 rejects V1 Solana names inside V2 kinds",
     "verifier": {
      "type": "command",
      "cmd": "PYTHONPATH=src python3 -m unittest -v tests.test_live.Live.test_s3_v1_name_in_v2",
      "expect_exit": 0,
      "min_tests": 1,
      "max_skipped": 0,
      "timeout_s": 300,
      "test_file": "tests/test_live.py"
     }
    },
    {
     "id": "XC-01-AC04",
     "mandatory": true,
     "statement": "S4 rejects an invalid feePayer",
     "verifier": {
      "type": "command",
      "cmd": "PYTHONPATH=src python3 -m unittest -v tests.test_live.Live.test_s4_bad_fee_payer",
      "expect_exit": 0,
      "min_tests": 1,
      "max_skipped": 0,
      "timeout_s": 300,
      "test_file": "tests/test_live.py"
     }
    },
    {
     "id": "XC-01-AC05",
     "mandatory": true,
     "statement": "S4 rejects a feePayer that is not a listed signer",
     "verifier": {
      "type": "command",
      "cmd": "PYTHONPATH=src python3 -m unittest -v tests.test_live.Live.test_s4_fee_payer_not_signer",
      "expect_exit": 0,
      "min_tests": 1,
      "max_skipped": 0,
      "timeout_s": 300,
      "test_file": "tests/test_live.py"
     }
    },
    {
     "id": "XC-01-AC06",
     "mandatory": true,
     "statement": "A conformant body passes S1-S4",
     "verifier": {
      "type": "command",
      "cmd": "PYTHONPATH=src python3 -m unittest -v tests.test_live.Live.test_s_all_pass_on_conformant_body",
      "expect_exit": 0,
      "min_tests": 1,
      "max_skipped": 0,
      "timeout_s": 300,
      "test_file": "tests/test_live.py"
     }
    },
    {
     "id": "XC-01-AC07",
     "mandatory": true,
     "statement": "Live mode issues exactly one GET and nothing else",
     "verifier": {
      "type": "command",
      "cmd": "PYTHONPATH=src python3 -m unittest -v tests.test_live.Live.test_live_mode_is_get_only",
      "expect_exit": 0,
      "min_tests": 1,
      "max_skipped": 0,
      "timeout_s": 300,
      "test_file": "tests/test_live.py"
     }
    },
    {
     "id": "XC-01-AC08",
     "mandatory": true,
     "statement": "Every changed file is inside this task's scope",
     "verifier": {
      "type": "scope"
     }
    },
    {
     "id": "XC-01-AC09",
     "mandatory": true,
     "statement": "Committed and pushed to main",
     "verifier": {
      "type": "pushed"
     }
    }
   ],
   "stop_rules": [
    "If a criterion cannot pass, STOP and report what blocks it, what was tried and what is needed. Never weaken a criterion, skip a test or raise a timeout to make it pass."
   ]
