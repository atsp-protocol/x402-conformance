  {
   "id": "XC-03",
   "title": "Lean models of the credit rule and nonce, standard axioms only",
   "phase": "verify",
   "owner": "mgillr",
   "depends_on": [],
   "requirements": [
    "R-LEAN"
   ],
   "description": "lean/ builds with the pinned toolchain; the six named theorems exist and depend only on standard axioms.",
   "scope": {
    "allow": [
     "lean/lean-toolchain",
     "lean/lakefile.toml",
     "lean/lake-manifest.json",
     "lean/X402Conformance.lean",
