{
  "name": "x402-conformance-svm",
  "version": "1.3.0",
  "description": "Resource-server checks for x402 V2: a facilitator double with fault modes and a probe that proves your paid route never serves content on a /settle timeout, a broken answer, settlement_pending or a duplicate. Solana devnet and Base Sepolia (exact).",
  "license": "Apache-2.0",
  "author": "Ryan Gillespie / Optitransfer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atsp-protocol/x402-conformance.git",
    "directory": "ts"
  },
  "homepage": "https://atsp-protocol.github.io/x402-conformance/",
  "bugs": {
    "url": "https://github.com/atsp-protocol/x402-conformance/issues"
  },
  "keywords": [
    "x402",
    "http-402",
    "agentic-payments",
    "ai-agents",
    "micropayments",
    "stablecoin",
    "usdc",
    "solana",
    "evm",
    "base",
    "conformance",
    "fault-injection",
    "ci",
    "sarif",
    "testing",
    "facilitator"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "x402conf-svm": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test --test-reporter=spec dist/test/*.test.js",
    "prepack": "tsc -p ."
  },
  "dependencies": {
    "@x402/core": "2.28.0"
  },
  "devDependencies": {
    "@solana/kit": "5.5.1",
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/svm": "2.28.0",
    "express": "4.22.3",
    "typescript": "5.6.3"
  }
}
